{
  "name": "crer",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run -A src/main.ts",
    "check": "deno check src/main.ts",
    "lint": "deno lint",
    "fmt": "dprint fmt --incremental=false",
    "fmt:check": "dprint check --incremental=false",
    "test": "deno test -A",
    "verify": "deno task check && deno task lint && deno task fmt:check && deno task test"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/yaml": "jsr:@std/yaml@^1.0.5"
  }
}
