<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Crer.Cli\Actions.cs" Link="Actions.cs" />
    <Compile Include="..\Crer.Cli\Prng.cs" Link="Prng.cs" />
    <Compile Include="..\Crer.Cli\InputGuard.cs" Link="InputGuard.cs" />
    <None Update="baseline-prng-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="baseline-action-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="baseline-key-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
